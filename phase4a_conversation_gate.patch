+++ b/scripts/smoke_conversation.py
@@ -0,0 +1,160 @@
+"""Interactive terminal smoke test for the multi-turn pipeline (Phase 4A).
+
+Requires running Ollama and Qdrant (same environment variables as
+frontend/app.py). It never creates or modifies a collection.
+
+Usage:
+    python scripts/smoke_conversation.py
+    python scripts/smoke_conversation.py --collection <existing_collection>
+
+Commands inside the loop: /new (new conversation), /quit.
+"""
+
+from __future__ import annotations
+
+import argparse
+import os
+import sys
+import uuid
+
+from qdrant_client import QdrantClient
+
+from ai_healthcare.agents.commander import Commander
+from ai_healthcare.agents.medical_rag import MedicalRAGAgent
+from ai_healthcare.agents.symptom import SymptomAgent
+from ai_healthcare.orchestration.agent_registry import AgentRegistry
+from ai_healthcare.orchestration.orchestrator import Orchestrator
+from ai_healthcare.providers.ollama_embedding_provider import (
+    OllamaEmbeddingProvider,
+)
+from ai_healthcare.providers.ollama_provider import OllamaProvider
+from ai_healthcare.retrieval.dense_retriever import DenseRetriever
+from ai_healthcare.schemas.conversation import ConversationState, TurnResult
+from ai_healthcare.schemas.vector import VectorStoreConfig
+from ai_healthcare.services.conversation_service import ConversationService
+from ai_healthcare.vectorstores.qdrant_store import QdrantVectorStore
+
+DEFAULT_COLLECTION = "medical_knowledge_bge_m3_multidomain_plaintext_v1"
+
+
+def build_service(collection: str) -> tuple[ConversationService, int]:
+    ollama_url = os.getenv("AI_HEALTHCARE_OLLAMA_URL", "http://127.0.0.1:11434")
+    chat_model = os.getenv("AI_HEALTHCARE_CHAT_MODEL", "qwen3:8b")
+    qdrant_url = os.getenv("AI_HEALTHCARE_QDRANT_URL", "http://127.0.0.1:6333")
+    embedding_model = "bge-m3"
+
+    probe = QdrantClient(url=qdrant_url, timeout=10.0)
+    try:
+        if not probe.collection_exists(collection):
+            raise SystemExit(f"Collection '{collection}' does not exist.")
+        points = probe.count(collection_name=collection, exact=True).count
+        if points <= 0:
+            raise SystemExit(f"Collection '{collection}' is empty.")
+    finally:
+        probe.close()
+
+    llm = OllamaProvider(base_url=ollama_url, model=chat_model)
+    embedder = OllamaEmbeddingProvider(base_url=ollama_url, model=embedding_model)
+    store = QdrantVectorStore(
+        url=qdrant_url,
+        config=VectorStoreConfig(
+            collection_name=collection,
+            vector_size=1024,
+            distance="cosine",
+            embedding_model=embedding_model,
+        ),
+    )
+    store.ensure_collection()  # validates the existing configuration
+
+    retriever = DenseRetriever(embedding_provider=embedder, vector_store=store)
+    symptom_agent = SymptomAgent(provider=llm)
+    rag_agent = MedicalRAGAgent(provider=llm, retriever=retriever, top_k=5)
+
+    registry = AgentRegistry()
+    registry.register(symptom_agent)
+    registry.register(rag_agent)
+    orchestrator = Orchestrator(
+        enabled_agents={"symptom", "medical_rag"}, registry=registry
+    )
+    commander = Commander(provider=llm, orchestrator=orchestrator)
+    service = ConversationService(
+        commander=commander,
+        symptom_agent=symptom_agent,
+        medical_rag_agent=rag_agent,
+    )
+    return service, points
+
+
+def render(result: TurnResult) -> None:
+    print(f"\n[{result.kind}] {result.latency_ms} ms")
+    if result.proposed_plan is not None:
+        proposed = [t.agent for t in result.proposed_plan.tasks]
+        executed = (
+            [t.agent for t in result.executed_plan.tasks]
+            if result.executed_plan
+            else None
+        )
+        print(f"  commander plan: {result.proposed_plan.intent} {proposed}")
+        print(f"  executed plan : {executed}")
+    if result.gate is not None:
+        print(
+            f"  gate          : allow={result.gate.allow} "
+            f"reason={result.gate.reason_code} "
+            f"limited={result.gate.limited_information}"
+        )
+    if result.symptom_output is not None:
+        for m in result.symptom_output.symptoms:
+            print(
+                f"  symptom       : {m.name} ({m.polarity}) "
+                f"onset={m.onset_text!r} duration={m.duration_text!r} "
+                f"severity={m.severity_text!r}"
+            )
+    if result.questions:
+        print("  questions:")
+        for q in result.questions:
+            print(f"    - {q}")
+    if result.message:
+        print(f"  message: {result.message}")
+    out = result.medical_output
+    if out is not None:
+        print(f"  rag status    : {out.status}")
+        for e in out.retrieved_evidence:
+            print(
+                f"  retrieved     : {e.similarity_score:.3f} "
+                f"{e.title} [{e.document_id}#{e.chunk_index}]"
+            )
+        print("\n" + out.answer_text)
+    if result.coverage_notice:
+        print(f"\n  ({result.coverage_notice})")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--collection",
+        default=os.getenv("AI_HEALTHCARE_QDRANT_COLLECTION", DEFAULT_COLLECTION),
+    )
+    args = parser.parse_args()
+
+    service, points = build_service(args.collection)
+    print(f"collection={args.collection} points={points}")
+
+    state = ConversationState.new(uuid.uuid4().hex)
+    while True:
+        try:
+            message = input("\nbạn> ")
+        except (EOFError, KeyboardInterrupt):
+            return 0
+        if message.strip() == "/quit":
+            return 0
+        if message.strip() == "/new":
+            state = ConversationState.new(uuid.uuid4().hex)
+            print("(đã bắt đầu hội thoại mới)")
+            continue
+        result = service.handle_turn(state, message)
+        state = result.state
+        render(result)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/src/ai_healthcare/orchestration/sufficiency_gate.py b/src/ai_healthcare/orchestration/sufficiency_gate.py
